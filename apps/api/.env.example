# 复制为 apps/api/.env 后按需修改；不提交到版本库。
# 所有变量都带 MASTERY_LAB_ 前缀，不设置时使用代码内默认值。

# 服务监听地址与端口
MASTERY_LAB_HOST=127.0.0.1
MASTERY_LAB_PORT=8000
MASTERY_LAB_LOG_LEVEL=info

# 数据目录（默认 <仓库根>/data），SQLite、密钥、上传文件都落在这里
# MASTERY_LAB_DATA_DIR=E:\前端转AI_Agent全栈\Mastery Lab\data

# 自定义数据库地址；留空则使用 <data_dir>/mastery_lab.db
# MASTERY_LAB_DATABASE_URL=sqlite:///E:/前端转AI_Agent全栈/Mastery Lab/data/mastery_lab.db

# 允许跨域访问的前端来源（JSON 数组）
MASTERY_LAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 调用 OpenAI 兼容接口的超时时间（秒）
MASTERY_LAB_LLM_TIMEOUT_SECONDS=20

MASTERY_LAB_LLM_STREAM_TIMEOUT_SECONDS=180
MASTERY_LAB_LLM_STREAM_TOTAL_TIMEOUT_SECONDS=240
MASTERY_LAB_LLM_REPLY_MAX_TOKENS=4096
MASTERY_LAB_CLASSROOM_CONTEXT_CHARS=6000
MASTERY_LAB_CLASSROOM_HISTORY_MESSAGES=20
MASTERY_LAB_CLASSROOM_HISTORY_CHARS=14000

# 注意：不要在 .env 中配置模型 API Key。
# 模型密钥只能通过应用内的「模型配置」页面写入，并由 Windows DPAPI 加密后存入 SQLite。
